# Environment variables for local development
# Backend debug toggles
ENV_ALLOW_RAW_IMAGE_UPLOAD_FOR_DEBUG=true
ENV_ALLOW_AUTO_ENROLL_FROM_RAW_FACE_DATA=true

# AI service URL
AI_SERVICE_URL=http://localhost:5001

# Similarity threshold (used as fallback if not configured elsewhere)
FACE_SIMILARITY_THRESHOLD=0.4

# Spring boot profile (dev/test)
SPRING_PROFILES_ACTIVE=local

# DB connection defaults (override with your local values)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/online_classroom?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=secret

# Redis (if used locally)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT secret (dev only)
JWT_SECRET=change-me-for-dev

# Logging
LOGGING_LEVEL_COM_BACKEND=DEBUG
